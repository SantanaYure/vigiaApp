# Porta HTTP em que o servidor Express irá rodar localmente
PORT=3001

# Chave de API do Google Gemini (obtenha gratuitamente em https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
AI_PROVIDER=gemini
# Provedor opcional compatível com a API OpenAI; os modelos OSS são hospedados pela Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
